{
  "manifest_version": 2,
  "name": "Stage vers Trello",
  "version": "2.0",
  "description": "Envoie l'offre ouverte vers ton tableau Trello en un clic",
  "browser_specific_settings": {
    "gecko": {
      "id": "stage-trello-saad@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ]
      }
    }
  },
  "permissions": [
    "activeTab",
    "storage",
    "identity",
    "https://api.trello.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "scripts": [
      "config.js",
      "lib/core.js",
      "background.js"
    ],
    "persistent": false
  },
  "icons": {
    "48": "icon.svg"
  },
  "browser_action": {
    "default_title": "Ajouter à Trello",
    "default_icon": "icon.svg",
    "default_popup": "popup.html"
  },
  "commands": {
    "_execute_browser_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      }
    }
  }
}
